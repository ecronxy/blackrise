// mono: ASCII-арт слева (~/.config/fastfetch/logo.txt), рамки со скруглёнными углами
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/logo.txt",
    "color": { "1": "white" },
    "padding": { "top": 0, "left": 1, "right": 3 }
  },
  "display": {
    "separator": "  ",
    "color": { "keys": "white", "title": "white", "output": "97" },
    "key": { "width": 12 }
  },
  "modules": [
    { "type": "custom", "format": "\u001b[97m╭─────────────── system ───────────────╮" },
    { "type": "title", "key": "│ user", "format": "{user-name}@{host-name}" },
    { "type": "os", "key": "│ os", "format": "{name} {version-id}" },
    { "type": "kernel", "key": "│ kernel" },
    { "type": "wm", "key": "│ wm", "format": "{pretty-name}" },
    { "type": "shell", "key": "│ shell" },
    { "type": "terminal", "key": "│ term" },
    { "type": "packages", "key": "│ pkgs" },
    { "type": "uptime", "key": "│ uptime" },
    { "type": "custom", "format": "\u001b[97m├────────────── hardware ──────────────┤" },
    { "type": "cpu", "key": "│ cpu", "format": "{name}" },
    { "type": "gpu", "key": "│ gpu", "format": "{name}" },
    { "type": "memory", "key": "│ memory" },
    { "type": "disk", "key": "│ disk", "folders": "/" },
    { "type": "custom", "format": "\u001b[97m╰──────────────────────────────────────╯" }
  ]
}
