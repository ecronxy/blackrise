# --- ЭЛТ-эффект: сканлайны, свечение, виньетка. Выключить: закомментировать строку ---
# custom-shader = shaders/crt.glsl   (выключен: тормозит на встроенной Vega 3)

# --- клавиши ---
keybind = ctrl+shift+enter=new_split:right
keybind = ctrl+shift+backslash=new_split:down
keybind = ctrl+alt+left=goto_split:left
keybind = ctrl+alt+right=goto_split:right
keybind = ctrl+alt+up=goto_split:up
keybind = ctrl+alt+down=goto_split:down
keybind = ctrl+shift+z=toggle_split_zoom
keybind = ctrl+equal=increase_font_size:1
keybind = ctrl+minus=decrease_font_size:1
keybind = ctrl+zero=reset_font_size

# --- буфер обмена как в обычных программах (Ctrl+C остаётся «прервать команду»)
keybind = ctrl+v=paste_from_clipboard
# Ctrl+Shift+V: передать программе «голый» Ctrl+V (вставка картинки в Claude Code)
keybind = ctrl+shift+v=text:\x16
keybind = ctrl+a=select_all
keybind = ctrl+g=copy_to_clipboard
