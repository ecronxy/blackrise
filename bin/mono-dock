#!/usr/bin/env python3
# mono-dock: чёрно-белый док слева для Hyprland + буфер обмена + снимок/запись экрана + индикатор звука.
#   док: сверху все приложения, закреплённые программы, буфер; под линией открытые окна;
#        по центру часы; снизу стоп записи, раскладка, питание.
#        клик: открыть / свернуть / развернуть; средняя кнопка: закрыть; правый клик: меню.
#   сигналы: USR2 буфер обмена (Super+V), USR1 снимок/запись (Ctrl/Super+Shift+S), HUP индикатор звука,
#            WINCH обзор окон (Super).
# Иконки программ: github.com/glincker/thesvg (MIT), вариант mono.
import os
