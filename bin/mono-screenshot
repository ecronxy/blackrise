#!/usr/bin/env python3
# mono-screenshot: панель снимка экрана как в GNOME Shell (Super+Shift+S, Ctrl+Shift+S, Print).
# Рисует панель снизу и рамку выделения (только затемнение и белая рамка, без картинки экрана).
# Замороженный кадр даёт hyprpicker, снимок grim, видео wf-recorder.
#   режимы: Выделение / Экран / Окно; переключатель Фото / Видео; показывать курсор.
#   Выделение: тянешь рамку (можно перетянуть заново). Экран: монитор под курсором. Окно: клик по окну.
#   Enter или Пробел снимает, Esc закрывает. Во время записи то же сочетание её останавливает.
#   mono-screenshot            фоновый процесс
#   mono-screenshot toggle     открыть панель / остановить запись
import os
import signal
import sys

RUN = os.environ.get("XDG_RUNTIME_DIR", "/tmp")
PID = os.path.join(RUN, "mono-screenshot.pid")
REC_PID = os.path.join(RUN, "mono-rec.pid")  # по нему док показывает кнопку «стоп»

if sys.argv[1:2] == ["toggle"]:
    try:
        os.kill(int(open(PID).read()), signal.SIGUSR1)
        sys.exit(0)
    except (FileNotFoundError, ValueError, ProcessLookupError):
        pass

LIB = "/usr/lib64/libgtk4-layer-shell.so.0"
if os.path.exists(LIB) and LIB not in os.environ.get("LD_PRELOAD", ""):
    os.environ["LD_PRELOAD"] = (LIB + " " + os.environ.get("LD_PRELOAD", "")).strip()
    os.execv(sys.executable, [sys.executable] + sys.argv)

import json  # noqa: E402
import subprocess  # noqa: E402
import threading  # noqa: E402
import time  # noqa: E402

import gi  # noqa: E402

gi.require_version("Gtk", "4.0")
gi.require_version("Gdk", "4.0")
gi.require_version("Gtk4LayerShell", "1.0")
gi.require_version("Graphene", "1.0")
from gi.repository import Gdk, Gio, GLib, Graphene, Gtk  # noqa: E402
from gi.repository import Gtk4LayerShell as LS  # noqa: E402

HOME = os.path.expanduser("~")
CLEAN_ENV = {k: v for k, v in os.environ.items() if k != "LD_PRELOAD"}
SHOTS = os.path.join(HOME, "Изображения", "Снимки экрана")
CASTS = os.path.join(HOME, "Видео", "Записи экрана")
ICONS = {
    "area": f"{HOME}/.local/share/mono-icons/gnome-shell/screenshot-ui-area-symbolic.svg",
    "display": f"{HOME}/.local/share/mono-icons/gnome-shell/screenshot-ui-display-symbolic.svg",
    "window": f"{HOME}/.local/share/mono-icons/gnome-shell/screenshot-ui-window-symbolic.svg",
    "pointer": f"{HOME}/.local/share/mono-icons/gnome-shell/screenshot-ui-show-pointer-symbolic.svg",
    "photo": "/usr/share/icons/Adwaita/symbolic/devices/camera-photo-symbolic.svg",
    "video": "/usr/share/icons/Adwaita/symbolic/devices/camera-web-symbolic.svg",
    "close": "/usr/share/icons/Adwaita/symbolic/ui/window-close-symbolic.svg",
}

# метрики screenshot-ui из GNOME Shell 49, цвета чёрно-белые
CSS = b"""
window { background: transparent; }
.ss button, .ss label, .ss image { background-image: none; box-shadow: none; text-shadow: none; outline: none; }
.ss {
  background: #000000; color: #ffffff; border: 1px solid rgba(255,255,255,0.18);
  border-radius: 28px; padding: 14px 18px 18px 18px; font-size: 11pt;
}
.ss-close {
  background: rgba(255,255,255,0.1); color: #ffffff; border: none; border-radius: 999px;
  min-width: 32px; min-height: 32px; padding: 0;
}
.ss-close:hover { background: rgba(255,255,255,0.18); }
.ss-type {
  background: rgba(255,255,255,0.1); color: #ffffff; border: none; border-radius: 14px;
  min-width: 96px; padding: 10px 16px; margin: 0 4px;
}
.ss-type:hover { background: rgba(255,255,255,0.18); }
.ss-type.on { background: #ffffff; color: #000000; }
.ss-type label { font-weight: normal; font-size: 10pt; }
.ss-switch { background: rgba(255,255,255,0.1); border-radius: 999px; padding: 3px; }
