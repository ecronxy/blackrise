#!/usr/bin/env python3
# mono-automount: флешки и внешние диски как в GNOME. Вставил: том монтируется,
# приходит уведомление и открываются Файлы. Без sudo: через gvfs (тот же механизм, что у Nautilus).
# Настройки берутся из GNOME: org.gnome.desktop.media-handling automount / automount-open.
import subprocess

import gi

gi.require_version("Gio", "2.0")
from gi.repository import Gio, GLib  # noqa: E402

MEDIA = Gio.Settings.new("org.gnome.desktop.media-handling")


def notify(title, body):
    subprocess.Popen(["notify-send", "-a", "Файлы", "-i", "drive-removable-media", title, body],
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def mount(vol):
    if vol.get_mount() or not vol.can_mount() or not vol.should_automount():
        return
    if not MEDIA.get_boolean("automount"):
        return
    name = vol.get_name()

    def done(v, res):
        try:
            v.mount_finish(res)
        except GLib.Error as e:
            notify("Не удалось подключить " + name, e.message)
            return
        m = v.get_mount()
        if m and MEDIA.get_boolean("automount-open"):
            subprocess.Popen(["nautilus", "--new-window", m.get_root().get_uri()],
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        notify("Подключено: " + name, "Извлечь можно в Файлах")
    op = Gio.MountOperation()
    vol.mount(Gio.MountMountFlags.NONE, op, None, done)


def main():
    mon = Gio.VolumeMonitor.get()
    mon.connect("volume-added", lambda m, v: mount(v))
    loop = GLib.MainLoop()
    loop.run()


if __name__ == "__main__":
    main()
