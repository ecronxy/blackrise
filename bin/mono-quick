#!/usr/bin/env python3
# mono-quick: быстрые настройки как в GNOME Shell (кнопка питания в доке, Super+X).
#   сверху: снимок, настройки, замок, питание (подменю: сон, перезагрузка, выключение, выход);
#   ползунки звука и микрофона со стрелкой выбора устройства;
#   плитки: Wi-Fi (стрелка: сети), VPN, режим питания (стрелка: режимы), не беспокоить.
# Иконки: Adwaita symbolic из самого GNOME.
#   mono-quick            фоновый процесс, окно держится наготове
#   mono-quick toggle     показать / спрятать
import os
import signal
import sys

RUN = os.environ.get("XDG_RUNTIME_DIR", "/tmp")
PID = os.path.join(RUN, "mono-quick.pid")

if sys.argv[1:2] == ["toggle"]:
    try:
        os.kill(int(open(PID).read()), signal.SIGUSR1)
        sys.exit(0)
    except (FileNotFoundError, ValueError, ProcessLookupError):
        pass  # не запущен: запускаемся и сразу показываем

LIB = "/usr/lib64/libgtk4-layer-shell.so.0"
if os.path.exists(LIB) and LIB not in os.environ.get("LD_PRELOAD", ""):
    os.environ["LD_PRELOAD"] = (LIB + " " + os.environ.get("LD_PRELOAD", "")).strip()
    os.execv(sys.executable, [sys.executable] + sys.argv)

import glob  # noqa: E402
import re  # noqa: E402
import subprocess  # noqa: E402
import threading  # noqa: E402

import gi  # noqa: E402

gi.require_version("Gtk", "4.0")
gi.require_version("Gdk", "4.0")
gi.require_version("Gtk4LayerShell", "1.0")
gi.require_version("Graphene", "1.0")
from gi.repository import Gdk, Gio, GLib, Graphene, Gtk  # noqa: E402
from gi.repository import Gtk4LayerShell as LS  # noqa: E402

HOME = os.path.expanduser("~")
MAIN_OUTPUT = os.environ.get("MONO_MAIN_OUTPUT", "")
CLEAN_ENV = {k: v for k, v in os.environ.items() if k != "LD_PRELOAD"}
ICON_DIRS = ["/usr/share/icons/Adwaita/symbolic", "/usr/share/icons/hicolor/symbolic"]
DOCK_W = 76

# метрики quick-settings из GNOME Shell 49, цвета чёрно-белые
CSS = b"""
